<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="SecretLetter.UI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="SecretLetter">
    <!--
      AI-GENERATED CODE: This file was written by Claude (Anthropic), replacing the original
      layout: the date code became a passphrase (with a confirmation when encrypting), Generate Key
      is connected, and the status line is a WinUI InfoBar. The control names keep the originals.
      SecretLetter is a project built with AI-generated code; see README.md.
    -->

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Padding="24" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
            <StackPanel Spacing="14" MaxWidth="680" HorizontalAlignment="Stretch" VerticalAlignment="Top">

                <TextBlock Text="SecretLetter" FontSize="24" FontWeight="SemiBold"/>
                <TextBlock TextWrapping="Wrap"
                           Text="Encrypts a Markdown letter (.md) into a .file, and decrypts it again, with your key and a passphrase. Everything happens on this PC."/>

                <!-- CONFIG FOLDER: holds config.json, which keeps the key. -->
                <Grid ColumnDefinitions="*, Auto" ColumnSpacing="10">
                    <TextBox x:Name="ConfigFolderPathBox"
                             Header="Config folder (holds config.json with your key)"
                             IsReadOnly="True"
                             PlaceholderText="Choose a folder..."/>
                    <Button x:Name="BrowseConfigFolderButton"
                            Grid.Column="1"
                            Content="Browse..."
                            MinWidth="120"
                            VerticalAlignment="Bottom"
                            Click="BrowseConfigFolderButton_Click"/>
                </Grid>

                <!-- INPUT AND OUTPUT FILES -->
                <Grid ColumnDefinitions="*, Auto" RowDefinitions="Auto, Auto" ColumnSpacing="10" RowSpacing="12">
                    <TextBox x:Name="InputPathBox"
                             Header="Input file (.md to encrypt, .file to decrypt)"
                             PlaceholderText="Choose a letter or an encrypted file..."
                             TextChanged="InputPathBox_TextChanged"/>
                    <Button x:Name="BrowseInputButton"
                            Grid.Column="1"
                            Content="Browse..."
                            MinWidth="120"
                            VerticalAlignment="Bottom"
                            Click="BrowseInputButton_Click"/>

                    <TextBox x:Name="OutputPathBox"
                             Grid.Row="1"
                             Header="Output file"
                             PlaceholderText="Choose where to save the result..."/>
                    <Button x:Name="BrowseOutputButton"
                            Grid.Row="1"
                            Grid.Column="1"
                            Content="Browse..."
                            MinWidth="120"
                            VerticalAlignment="Bottom"
                            Click="BrowseOutputButton_Click"/>
                </Grid>

                <!-- ROOT KEY: saved in config.json. -->
                <Grid ColumnDefinitions="*, Auto" ColumnSpacing="10">
                    <TextBox x:Name="RootKeyBox"
                             Header="Key (64 hexadecimal characters)"
                             FontFamily="Consolas"
                             IsSpellCheckEnabled="False"
                             PlaceholderText="Generate a key, or paste the key you were given..."/>
                    <Button x:Name="GenerateKeyButton"
                            Grid.Column="1"
                            Content="Generate Key"
                            MinWidth="120"
                            VerticalAlignment="Bottom"
                            Click="GenerateKeyButton_Click"/>
                </Grid>

                <!-- PASSPHRASE: never saved anywhere. -->
                <PasswordBox x:Name="PassphraseBox"
                             Header="Passphrase (at least 8 characters, never saved)"
                             PlaceholderText="Type your passphrase..."/>
                <PasswordBox x:Name="ConfirmPassphraseBox"
                             Header="Type the passphrase again"
                             PlaceholderText="Needed when encrypting, so a typing mistake can't lock the letter away..."
                             Visibility="Collapsed"/>

                <!-- ACTION BUTTONS -->
                <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,6,0,0">
                    <Button x:Name="RunButton"
                            Content="Run"
                            MinWidth="120"
                            Style="{StaticResource AccentButtonStyle}"
                            Click="RunButton_Click"/>
                    <Button x:Name="SaveConfigButton"
                            Content="Save Config"
                            MinWidth="120"
                            Click="SaveConfigButton_Click"/>
                    <Button x:Name="CloseButton"
                            Content="Close App"
                            MinWidth="120"
                            Click="CloseButton_Click"/>
                    <ProgressRing x:Name="BusyRing"
                                  IsActive="False"
                                  Width="24"
                                  Height="24"
                                  VerticalAlignment="Center"/>
                </StackPanel>

                <!-- STATUS -->
                <InfoBar x:Name="StatusBar"
                         IsOpen="True"
                         IsClosable="False"
                         Severity="Informational"
                         Title="Status"
                         Message="Ready. Choose your config folder to start."/>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Window>
